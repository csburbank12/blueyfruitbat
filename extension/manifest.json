{
  "manifest_version": 3,
  "name": "Sub Plan Generator",
  "short_name": "SubPlanGen",
  "version": "1.0.0",
  "description": "Generate ready-to-run substitute teacher plans in seconds using AI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://extensionpay.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["lib/ExtPay.js"],
      "run_at": "document_start"
    }
  ]
}
